<!DOCTYPE html>
<html data-bs-theme="dark">
  <head>
    <title>Manifestival</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="styles.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
  </head>

  <body>
    <div class="d-flex flex-column align-items-center p-4 gap-4">
      <h2>Manifestival: View IIIF 3D in Multiple Viewers</h2>
    </div>
    <div class="row px-4">
      <div class="col-lg-6" style="height: 670px;">
        <div class="d-flex align-items-center py-2 gap-2" style="">
          <label for="viewer-select">Viewer: </label>
          <select id="viewer-select" class="form-select">
            <% viewers.forEach(function(viewer) { %>
              <option value="<%= viewer.url %>"><%= viewer.name %></option>
            <% }); %>
          </select>
        </div>
        <iframe id="viewer" class="w-100" style="height: 608px;"></iframe>
      </div>

      <div class="col-lg-6"  style="height: 670px;">
        <div class="d-flex gap-2 py-2">
          <button id="load-manifest" class="btn btn-primary">Load Manifest Into Viewer</button>
          <button id="copy-share-url" class="btn btn-primary">Copy URL to Share View</button>
        </div>
        <textarea
          id="manifest"
          name="manifest"
          wrap="off"
          class="w-100"
          style="height: 500px;"
        ></textarea>
        <div class="manifest-inputs py-2">
          <div style="padding-right: 5px;">Select Example</div>
          <select id="manifest-select" class="form-select">
            <option value="">Select an Example Manifest</option>
            <% exampleManifests.forEach(function(group) { %>
              <optgroup label="<%= group.group %>">
              <% group.manifests.forEach(function(manifest) { %>
                <option value="<%= manifest.url %>"><%= manifest.name %></option>
              <% }); %>
              </optgroup>
            <% }); %>
          </select>
          <div style="padding-right: 5px;">Import URL</div>
          <div class="d-flex gap-2">
            <input type="text" id="manifest-from-url" class="form-control" placeholder="Manifest URL to Import" style="flex: 3">
            <button id="load-manifest-from-url" class="btn btn-primary" style="flex: 1">Load</button>
          </div>
        </div>
      </div>
    </div>
    <div class="row px-4 mt-4">
      <div class="col">
        <h3>How to Use</h3>
        <p>
          Manifestival lets you view IIIF Presentation API 4.0 manifest content across multiple 3D viewers.
          Select an example from the dropdown or paste a manifest URL into the Import URL field and click
          <strong>Load</strong> to fetch it. The manifest JSON will appear in the text area, where you can
          edit it freely. Click <strong>Load Manifest Into Viewer</strong> to render the current JSON in
          the selected viewer, or switch viewers using the Viewer dropdown to re-render immediately.
          Use <strong>Copy URL to Share View</strong> to copy a shareable link to the currently loaded manifest content to your clipboard.
        </p>
      </div>
    </div>

    <div class="row px-4 mt-2 mb-4">
      <div class="col">
        <h3>FAQ</h3>
        <div class="accordion" id="faq-accordion">
          <% faq.forEach(function(item, index) { %>
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button
                  class="accordion-button collapsed"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faq-<%= index %>"
                  aria-expanded="false"
                  aria-controls="faq-<%= index %>"
                ><%= item.question %></button>
              </h2>
              <div id="faq-<%= index %>" class="accordion-collapse collapse" data-bs-parent="#faq-accordion">
                <div class="accordion-body"><%= item.answer %></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </body>
</html>
